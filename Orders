function buildOwnerNotificationText(orderId, orderRow, products) {
  const productTotal = calculateTotal(products);
  const managedTotal = calculateManagedTotal(products);
  const managedCount = countManagedProducts(products);
  const managedOrder = managedCount === products.length;
  const mixedOrder = managedCount > 0 && managedCount < products.length;
  const deliveryPriceValue = orderRow[15];
  const deliveryPrice = deliveryPriceValue === '' || deliveryPriceValue === null || deliveryPriceValue === undefined ? null : normalizeMoney(deliveryPriceValue);

  let text = '🛍 НОВЫЙ ЗАКАЗ\n\n';
  if (managedOrder || mixedOrder) text += '⚒️ НА ЗАКАЗ / СЕРВИС\n\n';
  text += buildItemsTextFromProducts(products) + '\n\n';
  text += '💰 К оплате сейчас: ' + formatMoney(managedOrder ? 0 : calculatePayableNowTotal(products) + (deliveryPrice == null ? 0 : deliveryPrice)) + ' ₽\n';
  if (managedTotal) text += '⚒️ На заказ / сервис: ' + formatMoney(managedTotal) + ' ₽\n';
  if (String(orderRow[5] || '').trim()) text += '🚚 Доставка: ' + String(orderRow[5]).trim() + '\n';
  if (deliveryPrice == null && String(orderRow[9] || '').trim()) text += '💰 Итого: ' + formatMoney(Number(orderRow[6] || 0)) + ' ₽ + доставка по согласованию\n';
  else text += '💰 Итого: ' + formatMoney(Number(orderRow[6] || 0)) + ' ₽\n';
  if (orderRow[16]) text += '📦 Служба доставки: ' + String(orderRow[16]).trim() + '\n';
  if (orderRow[17]) text += '🌍 Страна: ' + String(orderRow[17]).trim() + '\n';
  if (orderRow[10]) text += '📍 Куда доставить: ' + String(orderRow[10]).trim() + '\n';
  text += '\n👤 Клиент: ' + String(orderRow[13] || '').trim() + '\n';
  if (orderRow[3]) text += '💬 Telegram: ' + String(orderRow[3]).trim() + '\n';
  text += orderRow[11] ? '📱 Телефон: ' + String(orderRow[11]).trim() + '\n' : '📱 Телефон: не предоставлен\n';
  text += '💬 Способ связи: ' + (String(orderRow[12] || '').indexOf('Связь: телефон') !== -1 ? 'телефон' : 'Telegram') + '\n';
  const payment = String(orderRow[8] || '').trim();
  if (payment === 'клиент подтвердил оплату') text += '\n💳 Клиент подтвердил оплату.';
  else if (payment === 'клиент ожидает менеджера') text += '\n⏳ Клиент ожидает диалога перед оплатой.';
  else if (payment === 'требует согласования') text += '\n⚒️ Заказ требует согласования.';
  else if (payment) text += '\n💰 Статус оплаты: ' + payment;
  return text;
}

function sendOwnerNotificationForOrder(orderId, telegramId) {
  const ss = SpreadsheetApp.openById(SHEET_ID);
  const ordersSheet = ss.getSheetByName(ORDERS_SHEET_NAME);
  const compositionSheet = ss.getSheetByName(COMPOSITION_SHEET_NAME);
  if (!ordersSheet || !compositionSheet) throw new Error('Не найдены листы заказа.');
  const orderRow = findOrderRow(ordersSheet, orderId);
  if (!orderRow) throw new Error('Заказ не найден.');
  if (String(orderRow[2] || '').trim() !== String(telegramId || '').trim()) throw new Error('Заказ принадлежит другому пользователю.');
  const products = getCompositionProducts(compositionSheet, orderId);
  if (!products.length) throw new Error('В составе заказа нет товаров.');
  telegramApi(getBotToken(), 'sendMessage', {chat_id: getOwnerTelegramId(), text: buildOwnerNotificationText(orderId, orderRow, products)});
}

