const ORDERS_SHEET_NAME = 'Заказы';
const COMPOSITION_SHEET_NAME = 'Состав';
const BOT_TOKEN_PROPERTY = 'BOT_TOKEN';
const MANAGED_CATEGORIES = ['repeat', 'service'];
const PAYABLE_NOW_CATEGORIES = ['items', 'diogen', 'lockers'];
const STOCK_API_URL = 'https://script.google.com/macros/s/AKfycbwHw6-UO84o6pPDyQ72PEb5qiOV9TeJBMrpjnvF9n-jtOokDYVf8w702IQKLvm_k6UxvQ/exec';

