  'ID заказа', 'Дата', 'Telegram ID', 'Telegram',
  'Товары', 'Доставка', 'Итого', 'Статус',
  'Оплата', 'Получение', 'Адрес', 'Телефон', 'Комментарий',
  'Имя', 'Способ доставки', 'Стоимость доставки', 'Служба доставки', 'Страна'
];

const COMPOSITION_HEADERS = [
  'ID заказа', 'Товар', 'Категория', 'Количество', 'Цена', 'Сумма'
];

function doGet() {
  return jsonResponse({ok: true, service: 'Orders'});
}

function doPost(e) {
  try {
    if (!e || !e.postData || !e.postData.contents) {
      throw new Error('Не получены данные запроса.');
    }

    const data = JSON.parse(e.postData.contents);
    const action = String(data.action || '');

    if (action === 'create-order') return jsonResponse(createOrder(data));
    if (action === 'receive-contact') return jsonResponse(receiveContact(data));
    if (action === 'get-order') return jsonResponse(getOrderForBot(data));

    throw new Error('Неизвестное действие: ' + action);
  } catch (error) {
    console.error(error);
    return jsonResponse({
      ok: false,
      error: String(error && error.message || error)
    });
  }
}

function createOrder(data) {
  const initData = String(data.initData || '').trim();
  if (!initData) throw new Error('Не передан Telegram initData.');

  const telegramUser = validateTelegramInitData(initData);
  if (!telegramUser || !telegramUser.id) {
    throw new Error('Не удалось подтвердить Telegram пользователя.');
  }

  const products = Array.isArray(data.products) ? data.products : [];
  if (!products.length) throw new Error('В заказе нет товаров.');

  const runtimeProducts = normalizeRuntimeProducts(products);
  const needsDelivery = Boolean(data.needs_delivery);
  const delivery = normalizeDelivery(data.delivery, needsDelivery);
  const contactMethod = String(data.contact_method || '').trim().toLowerCase();
  const postOrderAction = String(data.post_order_action || '').trim().toLowerCase();

  if (!['telegram', 'phone'].includes(contactMethod)) {
    throw new Error('Не выбран способ связи.');
  }

  const username = formatTelegramUsername(telegramUser.username);
  if (contactMethod === 'telegram' && !username) {
    throw new Error('Чтобы связаться через Telegram, добавьте @username в Telegram.');
  }

  const managedCount = countManagedProducts(runtimeProducts);
  const managedOrder = managedCount === runtimeProducts.length;
  const mixedOrder = managedCount > 0 && managedCount < runtimeProducts.length;

  if (managedOrder) {
    if (postOrderAction !== 'managed') throw new Error('Некорректное действие для заказа на заказ/сервис.');
  } else if (!['paid', 'wait_manager'].includes(postOrderAction)) {
    throw new Error('Не выбрано действие после заказа.');
  }

  const lock = LockService.getScriptLock();
  lock.waitLock(30000);

  let orderId;
  let orderMeta;
  let itemsText;
  let telegramId;

  try {
    const ss = SpreadsheetApp.openById(SHEET_ID);
    const ordersSheet = getRequiredSheet(ss, ORDERS_SHEET_NAME, ORDERS_HEADERS);
    const compositionSheet = getRequiredSheet(ss, COMPOSITION_SHEET_NAME, COMPOSITION_HEADERS);

    orderId = nextOrderId(ordersSheet);
    const now = new Date();
    telegramId = String(telegramUser.id);

    const productTotal = calculateTotal(runtimeProducts);
    const managedTotal = calculateManagedTotal(runtimeProducts);
    const repeatCount = countCategory(runtimeProducts, 'repeat');
    const serviceCount = countCategory(runtimeProducts, 'service');
    const repeatOrder = repeatCount === runtimeProducts.length;
    const serviceOrder = serviceCount === runtimeProducts.length;
    const payableGoodsTotal = calculatePayableNowTotal(runtimeProducts);
    const deliveryPrice = delivery.price == null ? 0 : delivery.price;
    const total = productTotal + deliveryPrice;
    const payableTotal = managedOrder ? 0 : payableGoodsTotal + deliveryPrice;
    itemsText = buildItemsText(data.items, runtimeProducts);

    let paymentStatus = 'не оплачено';
    if (postOrderAction === 'paid') paymentStatus = 'клиент подтвердил оплату';
    if (postOrderAction === 'wait_manager') paymentStatus = 'клиент ожидает менеджера';
    if (postOrderAction === 'managed') paymentStatus = 'требует согласования';

    const contactComment = contactMethod === 'telegram' ? 'Связь: Telegram' : 'Связь: телефон';
    const deliveryComment = formatDeliveryComment(delivery);
    const comment = [deliveryComment, contactComment].filter(Boolean).join('; ');

    ordersSheet.appendRow([
      orderId,
      now,
      telegramId,
      username,
      itemsText,
      formatDeliveryForSheet(delivery),
      total,
      'новый',
      paymentStatus,
      delivery.method_id,
      delivery.address,
      '',
      comment,
      String(telegramUser.first_name || '').trim(),
      delivery.method_title,
      delivery.price == null ? '' : delivery.price,
      delivery.service_title,
      delivery.country
    ]);

    const compositionRows = products.map(function(product) {
      const name = String(product.name || '').trim() || String(product.title || '').trim() || 'Без названия';
      const category = String(product.category || '').trim().toLowerCase();
      const quantity = normalizeQuantity(product.quantity);
      const price = normalizeMoney(product.price);
      return [orderId, name, category, quantity, price, price * quantity];
    });

    if (compositionRows.length) {
      compositionSheet.getRange(
        compositionSheet.getLastRow() + 1,
        1,
        compositionRows.length,
        COMPOSITION_HEADERS.length
      ).setValues(compositionRows);
    }

    orderMeta = {
      productTotal: productTotal,
      managedTotal: managedTotal,
      payableGoodsTotal: payableGoodsTotal,
      payableTotal: payableTotal,
      total: total,
      managedOrder: managedOrder,
      repeatOrder: repeatOrder,
      serviceOrder: serviceOrder,
      mixedOrder: mixedOrder,
      needsDelivery: needsDelivery,
      delivery: delivery,
      postOrderAction: postOrderAction,
      contactMethod: contactMethod
    };

  } finally {
    lock.releaseLock();
  }

  // Пользователь уже завершил диалог в Mini App.
  // Сначала отправляем ему финал и уведомляем владельца,
  // а остатки обрабатываем отдельно и не делаем их условием успеха заказа.
  try {
    sendCustomerFinalMessage(telegramId, orderId, itemsText, orderMeta);
  } catch (error) {
    console.error('Не удалось отправить финал клиенту:', error);
  }

  try {
    sendOwnerNotificationForOrder(orderId, telegramId);
  } catch (error) {
    console.error('Не удалось отправить уведомление владельцу:', error);
  }

  if (orderMeta.postOrderAction === 'paid' && !orderMeta.managedOrder) {
    const stockResult = processStock(runtimeProducts);
    if (!stockResult.ok) {
      try {
        sendStockFailureNotification(telegramId, orderId, itemsText, stockResult.error);
      } catch (error) {
        console.error('Не удалось отправить предупреждение об остатках:', error);
      }
    }
  }

  return { ok: true, orderId: orderId, telegramId: telegramId };
}

function processStock(products) {
  const items = products
    .filter(function(product) {
      return String(product.category || '').trim().toLowerCase() === 'items';
    })
    .map(function(product) {
      return {
        name: String(product.name || product.title || '').trim(),
        quantity: normalizeQuantity(product.quantity)
      };
    });

  if (!items.length) return { ok: true };

  try {
    const response = UrlFetchApp.fetch(STOCK_API_URL, {
      method: 'post',
      contentType: 'application/json',
      payload: JSON.stringify({action: 'check_and_decrement', items: items}),
      muteHttpExceptions: true
    });

    const code = response.getResponseCode();
    const body = response.getContentText();
    if (code < 200 || code >= 300) {
      console.error('Stock HTTP ' + code + ': ' + body);
      return {ok: false, error: 'Не удалось связаться с системой остатков.'};
    }

    let result;
    try { result = JSON.parse(body); }
    catch (error) { return {ok: false, error: 'Система остатков вернула некорректный ответ.'}; }

    console.log('Ответ системы остатков:', result);
    return result && result.ok
      ? {ok: true}
      : {ok: false, error: String(result && result.error || 'Не удалось обновить остатки.')};
  } catch (error) {
    console.error('Ошибка системы остатков:', error);
    return {ok: false, error: 'Не удалось связаться с системой остатков.'};
  }
}

function sendCustomerFinalMessage(chatId, orderId, itemsText, meta) {
  const delivery = meta.delivery || {};
  const botToken = getBotToken();

  let text = '✅ Заказ №' + orderId + '\n\n' + itemsText + '\n\n';

  if (delivery.method_id) {
    text += '🚚 Доставка: ' + delivery.method_title;
    text += delivery.price == null ? ' — договорная\n' : ' — ' + formatMoney(delivery.price) + ' ₽\n';
    if (delivery.service_title) text += '📦 Служба доставки: ' + delivery.service_title + '\n';
    if (delivery.country) text += '🌍 Страна: ' + delivery.country + '\n';
    if (delivery.address) text += '📍 Адрес: ' + delivery.address + '\n';
    text += '\n';
  }

  text += '💰 К оплате сейчас: ' + formatMoney(meta.managedOrder ? 0 : meta.payableTotal) + ' ₽\n';
  if (meta.mixedOrder && meta.managedTotal > 0) {
    text += '⚒️ На заказ / сервис: ' + formatMoney(meta.managedTotal) + ' ₽\n';
  }
  if (delivery.price == null && delivery.method_id) {
    text += '💰 Итого: ' + formatMoney(meta.payableTotal) + ' ₽ + доставка по согласованию\n\n';
  } else {
    text += '💰 Итого: ' + formatMoney(meta.total) + ' ₽\n\n';
  }

  if (meta.managedOrder) {
    text += '⚒️ Заказ требует согласования.\n\n';
  } else if (meta.postOrderAction === 'paid') {
    text += '💳 Вы отметили, что оплатили заказ.\n\n';
  } else {
    text += '⏳ Вы выбрали дождаться связи с мастером до оплаты.\n\n';
  }

  if (meta.contactMethod === 'telegram') text += '💬 Связь: Telegram\n';
  if (meta.contactMethod === 'phone') text += '📱 Связь: телефон\n';

  if (meta.managedOrder) {
    text += '\nСпасибо! Всё записал и передал мастеру. Мастер свяжется с вами в рабочее время Пн–Пт, 10:00–18:00 (Екатеринбург).';
  } else if (meta.postOrderAction === 'wait_manager') {
    text += '\nСпасибо! Мастер свяжется с вами в рабочее время Пн–Пт, 10:00–18:00 (Екатеринбург), чтобы обсудить и подтвердить заказ.';
  } else if (delivery.method_id === 'courier_ekb') {
    text += '\nСпасибо! Всё записал и передал мастеру. Мастер свяжется с вами в рабочее время Пн–Пт, 10:00–18:00 (Екатеринбург), чтобы организовать доставку. Спасибо за заказ!';
  } else {
    text += '\nСпасибо! Всё записал и передал мастеру. Мастер свяжется с вами в рабочее время Пн–Пт, 10:00–18:00 (Екатеринбург), чтобы сообщить о готовности заказа. Спасибо за заказ!';
  }

  telegramApi(botToken, 'sendMessage', {chat_id: chatId, text: text, parse_mode: 'HTML'});
  sendHubMenu(chatId);
}

