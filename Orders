/**
 * Странные Вещи — Orders Google Apps Script
 * Shop Mini App -> Orders -> Telegram bot.
 *
 * Технический ID товара живёт только во временном Script Property
 * и не попадает в исторический лист "Состав".
 */

const SHEET_ID = '1FcetqNVvXNI78h0mcQdEJBEVXzkHcgaddFrCn2VOugk';
const ORDERS_SHEET_NAME = 'Заказы';
const COMPOSITION_SHEET_NAME = 'Состав';
const BOT_TOKEN_PROPERTY = 'BOT_TOKEN';
const ORDER_PAYLOAD_PREFIX = 'ORDER_PAYLOAD_';
const ORDER_PAYLOAD_TTL_MS = 24 * 60 * 60 * 1000;
const MANAGED_CATEGORIES = ['repeat', 'service'];

const ORDERS_HEADERS = [
  'ID заказа', 'Дата', 'Telegram ID', 'Telegram',
  'Товары', 'Доставка', 'Итого', 'Статус',
  'Оплата', 'Получение', 'Адрес', 'Телефон', 'Комментарий',
  'Имя', 'Способ доставки', 'Стоимость доставки', 'Служба доставки', 'Страна'
];

const COMPOSITION_HEADERS = [
  'ID заказа', 'Товар', 'Категория', 'Количество', 'Цена', 'Сумма'
];

function doGet() {
  return jsonResponse({ok: true, service: 'Orders'});
}

function doPost(e) {
  try {
    if (!e || !e.postData || !e.postData.contents) {
      throw new Error('Не получены данные запроса.');
    }

    const data = JSON.parse(e.postData.contents);
    const action = String(data.action || '');

    if (action === 'create-order') return jsonResponse(createOrder(data));
    if (action === 'get-order') return jsonResponse(getOrderForBot(data));

    throw new Error('Неизвестное действие: ' + action);
  } catch (error) {
    console.error(error);
    return jsonResponse({
      ok: false,
      error: String(error && error.message || error)
    });
  }
}

function createOrder(data) {
  const initData = String(data.initData || '').trim();
  if (!initData) throw new Error('Не передан Telegram initData.');

  const telegramUser = validateTelegramInitData(initData);
  if (!telegramUser || !telegramUser.id) {
    throw new Error('Не удалось подтвердить Telegram пользователя.');
  }

  const products = Array.isArray(data.products) ? data.products : [];
  if (!products.length) throw new Error('В заказе нет товаров.');

  const runtimeProducts = normalizeRuntimeProducts(products);
  const needsDelivery = Boolean(data.needs_delivery);
  const delivery = normalizeDelivery(data.delivery, needsDelivery);

  const lock = LockService.getScriptLock();
  lock.waitLock(30000);

  try {
    cleanupExpiredOrderPayloads();

    const ss = SpreadsheetApp.openById(SHEET_ID);
    const ordersSheet = getRequiredSheet(ss, ORDERS_SHEET_NAME, ORDERS_HEADERS);
    const compositionSheet = getRequiredSheet(ss, COMPOSITION_SHEET_NAME, COMPOSITION_HEADERS);

    const orderId = nextOrderId(ordersSheet);
    const now = new Date();
    const telegramId = String(telegramUser.id);
    const username = formatTelegramUsername(telegramUser.username);

    const productTotal = calculateTotal(runtimeProducts);
    const managedTotal = calculateManagedTotal(runtimeProducts);
    const managedCount = countManagedProducts(runtimeProducts);
    const repeatCount = countCategory(runtimeProducts, 'repeat');
    const serviceCount = countCategory(runtimeProducts, 'service');
    const repeatOrder = repeatCount === runtimeProducts.length;
    const serviceOrder = serviceCount === runtimeProducts.length;
    const managedOrder = managedCount === runtimeProducts.length;
    const mixedOrder = managedCount > 0 && managedCount < runtimeProducts.length;
    const payableGoodsTotal = Math.max(0, productTotal - managedTotal);
    const deliveryPrice = delivery.price == null ? 0 : delivery.price;
    const total = productTotal + deliveryPrice;
    const payableTotal = managedOrder ? 0 : payableGoodsTotal + deliveryPrice;
    const itemsText = buildItemsText(data.items, runtimeProducts);

    ordersSheet.appendRow([
      orderId,
      now,
      telegramId,
      username,
      itemsText,
      formatDeliveryForSheet(delivery),
      total,
      'новый',
      'не оплачено',
      delivery.method_id,
      delivery.address,
      '',
      formatDeliveryComment(delivery),
      String(telegramUser.first_name || '').trim(),
      delivery.method_title,
      delivery.price == null ? '' : delivery.price,
      delivery.service_title,
      delivery.country
    ]);

    const compositionRows = products.map(function(product) {
      const name = String(product.name || '').trim() || String(product.title || '').trim() || 'Без названия';
      const category = String(product.category || '').trim().toLowerCase();
      const quantity = normalizeQuantity(product.quantity);
      const price = normalizeMoney(product.price);
      return [orderId, name, category, quantity, price, price * quantity];
    });

    if (compositionRows.length) {
      compositionSheet
        .getRange(compositionSheet.getLastRow() + 1, 1, compositionRows.length, COMPOSITION_HEADERS.length)
        .setValues(compositionRows);
    }

    const orderMeta = {
      productTotal: productTotal,
      managedTotal: managedTotal,
      payableGoodsTotal: payableGoodsTotal,
      payableTotal: payableTotal,
      total: total,
      managedOrder: managedOrder,
      repeatOrder: repeatOrder,
      serviceOrder: serviceOrder,
      mixedOrder: mixedOrder,
      needsDelivery: needsDelivery,
      delivery: delivery
    };

    storeOrderPayload(orderId, telegramId, runtimeProducts, orderMeta);
    sendOrderMessage(telegramId, orderId, itemsText, orderMeta);

    return {
      ok: true,
      orderId: orderId,
      telegramId: telegramId
    };
  } finally {
    lock.releaseLock();
  }
}

function normalizeRuntimeProducts(products) {
  return products.map(function(product) {
    const normalized = Object.assign({}, product);
    normalized.category = String(product.category || '').trim().toLowerCase();
    return normalized;
  });
}

function normalizeDelivery(data, needsDelivery) {
  if (!needsDelivery || !data) {
    return {
      method_id: '',
      method_title: '',
      price: 0,
      service_id: '',
      service_title: '',
      country: '',
      address: ''
    };
  }

  const methodId = String(data.method_id || '').trim();
  const methodTitle = String(data.method_title || '').trim();
  if (!methodId || !methodTitle) throw new Error('Не выбран способ доставки.');

  let price = null;
  if (data.price !== null && data.price !== undefined && data.price !== '') {
    const parsed = Number(data.price);
    if (!Number.isFinite(parsed) || parsed < 0) throw new Error('Некорректная стоимость доставки.');
    price = parsed;
  }

  const serviceId = String(data.service_id || '').trim();
  const serviceTitle = String(data.service_title || '').trim();
  const country = String(data.country || '').trim();
  const address = String(data.address || '').trim();

  if (methodId === 'courier_ekb' && address.length < 3) {
    throw new Error('Не указан адрес доставки.');
  }

  if (methodId === 'russia') {
    if (!serviceId || !serviceTitle) throw new Error('Не выбрана служба доставки.');
    if (address.length < 3) throw new Error('Не указан адрес ПВЗ.');
  }

  if (methodId === 'abroad' && !country) {
    throw new Error('Не выбрана страна доставки.');
  }

  return {
    method_id: methodId,
    method_title: methodTitle,
    price: price,
    service_id: serviceId,
    service_title: serviceTitle,
    country: country,
    address: methodId === 'abroad' ? '' : address
  };
}

function formatDeliveryForSheet(delivery) {
  if (!delivery || !delivery.method_id) return '';

  const parts = [delivery.method_title];
  parts.push(delivery.price == null ? 'договорная' : formatMoney(delivery.price) + ' ₽');
  if (delivery.service_title) parts.push(delivery.service_title);
  if (delivery.country) parts.push(delivery.country);
  return parts.join(' — ');
}

function formatDeliveryComment(delivery) {
  if (!delivery || !delivery.method_id) return '';
  const parts = [];
  if (delivery.service_title) parts.push('Служба: ' + delivery.service_title);
  if (delivery.country) parts.push('Страна: ' + delivery.country);
  return parts.join('; ');
}

function sendOrderMessage(chatId, orderId, itemsText, meta) {
  const botToken = getBotToken();
  const delivery = meta.delivery || {};

  let text = 'Ваш заказ №' + orderId + ':\n\n' + itemsText + '\n\n';

  if (delivery.method_id) {
    text += '🚚 Доставка: ' + delivery.method_title;
    text += delivery.price == null
      ? ' — договорная\n'
      : ' — ' + formatMoney(delivery.price) + ' ₽\n';
    if (delivery.service_title) text += '📦 Служба доставки: ' + delivery.service_title + '\n';
    if (delivery.country) text += '🌍 Страна: ' + delivery.country + '\n';
    if (delivery.address) text += '📍 Адрес: ' + delivery.address + '\n';
    text += '\n';
  }

  if (meta.managedOrder) {
    text += '⚒️ Заказ требует согласования.\n\nОставьте контакт, и менеджер свяжется с вами по поводу заказа.';

    telegramApi(botToken, 'sendMessage', {
      chat_id: chatId,
      text: text,
      reply_markup: JSON.stringify({
        inline_keyboard: [[
          {text: '📞 Оставить контакт', callback_data: 'order_contact'}
        ]]
      })
    });
    return;
  }

  text += '💰 Товары к оплате: <b>' + formatMoney(meta.payableGoodsTotal) + ' ₽</b>\n';

  if (meta.mixedOrder && meta.managedTotal > 0) {
    text += '⚒️ На заказ / сервис: ' + formatMoney(meta.managedTotal) + ' ₽\n';
  }

  if (delivery.price == null && delivery.method_id) {
    text += '💰 Итого: <b>' + formatMoney(meta.payableTotal) + ' ₽</b> + доставка по согласованию\n\n';
  } else {
    text += '💰 Итого: <b>' + formatMoney(meta.total) + ' ₽</b>\n\n';
  }

  text +=
    '💳 Оплата переводом на Сбербанк:\n' +
    '📱 +79089147913\n' +
    '👤 Получатель: Лия П.\n\n' +
    '📦 Заказ будет собран после оплаты.\n\n' +
    'Вы можете перевести оплату сейчас или дождаться связи с менеджером в рабочее время:\n' +
    'Пн–Пт, 10:00–18:00 (Екатеринбург).';

  telegramApi(botToken, 'sendMessage', {
    chat_id: chatId,
    text: text,
    parse_mode: 'HTML',
    reply_markup: JSON.stringify({
      inline_keyboard: [[
        {text: '💳 Я оплатил', callback_data: 'paid'},
        {text: '⏳ Подожду менеджера', callback_data: 'wait_manager'}
      ]]
    })
  });
}

function getOrderForBot(data) {
  const botToken = getBotToken();
  const apiToken = String(data.api_token || '');
  if (!apiToken || !constantTimeEqual(apiToken, botToken)) throw new Error('Недействительный API-токен.');

  const orderId = String(data.order_id || '').trim();
  const telegramId = String(data.telegram_id || '').trim();
  if (!orderId) throw new Error('Не указан ID заказа.');
  if (!telegramId) throw new Error('Не указан Telegram ID.');

  const ss = SpreadsheetApp.openById(SHEET_ID);
  const ordersSheet = ss.getSheetByName(ORDERS_SHEET_NAME);
  const compositionSheet = ss.getSheetByName(COMPOSITION_SHEET_NAME);
  if (!ordersSheet) throw new Error('Не найден лист Заказы.');
  if (!compositionSheet) throw new Error('Не найден лист Состав.');

  const orderRow = findOrderRow(ordersSheet, orderId);
  if (!orderRow) throw new Error('Заказ не найден.');

  const storedTelegramId = String(orderRow[2] || '').trim();
  if (storedTelegramId !== telegramId) throw new Error('Этот заказ принадлежит другому Telegram пользователю.');

  const products = getCompositionProducts(compositionSheet, orderId);
  if (!products.length) throw new Error('В листе Состав не найден состав заказа.');

  const productTotal = calculateTotal(products);
  const managedTotal = calculateManagedTotal(products);
  const managedCount = countManagedProducts(products);
  const repeatCount = countCategory(products, 'repeat');
  const serviceCount = countCategory(products, 'service');
  const managedOrder = managedCount === products.length;
  const repeatOrder = repeatCount === products.length;
  const serviceOrder = serviceCount === products.length;
  const mixedOrder = managedCount > 0 && managedCount < products.length;

  const deliveryPriceText = String(orderRow[15] || '').trim();
  const deliveryPrice = deliveryPriceText === '' ? null : normalizeMoney(orderRow[15]);
  const payableGoodsTotal = Math.max(0, productTotal - managedTotal);
  const payableTotal = managedOrder
    ? 0
    : payableGoodsTotal + (deliveryPrice == null ? 0 : deliveryPrice);

  return {
    ok: true,
    order: {
      order_id: orderId,
      telegram_id: storedTelegramId,
      username: String(orderRow[3] || '').trim(),
      first_name: String(orderRow[13] || '').trim(),
      items: buildItemsTextFromProducts(products),
      products: products,
      product_total: productTotal,
      payable_goods_total: payableGoodsTotal,
      payable_total: payableTotal,
      managed_product_total: managedTotal,
      total: Number(orderRow[6] || 0),
      needs_delivery: Boolean(String(orderRow[5] || '').trim() || String(orderRow[9] || '').trim()),
      managed_order: managedOrder,
      repeat_order: repeatOrder,
      service_order: serviceOrder,
      mixed_order: mixedOrder,
      delivery: String(orderRow[5] || '').trim(),
      delivery_id: String(orderRow[9] || '').trim(),
      delivery_title: String(orderRow[14] || '').trim(),
      delivery_price: deliveryPrice,
      delivery_service: String(orderRow[16] || '').trim(),
      delivery_country: String(orderRow[17] || '').trim(),
      delivery_address: String(orderRow[10] || '').trim(),
      status: String(orderRow[7] || '').trim(),
      payment: String(orderRow[8] || '').trim(),
      receiving: String(orderRow[9] || '').trim(),
      address: String(orderRow[10] || '').trim(),
      phone: String(orderRow[11] || '').trim(),
      comment: String(orderRow[12] || '').trim()
    }
  };
}

function getCompositionProducts(sheet, orderId) {
  if (sheet.getLastRow() < 2) return [];

  const rows = sheet.getRange(2, 1, sheet.getLastRow() - 1, COMPOSITION_HEADERS.length).getValues();
  return rows
    .filter(function(row) {
      return String(row[0] || '').trim() === String(orderId);
    })
    .map(function(row) {
      return {
        id: '',
        name: String(row[1] || '').trim() || 'Без названия',
        category: String(row[2] || '').trim().toLowerCase(),
        quantity: normalizeQuantity(row[3]),
        price: normalizeMoney(row[4])
      };
    });
}

function findOrderRow(sheet, orderId) {
  if (sheet.getLastRow() < 2) return null;
  const rows = sheet.getRange(2, 1, sheet.getLastRow() - 1, 18).getValues();
  for (let i = 0; i < rows.length; i++) {
    if (String(rows[i][0] || '').trim() === orderId) return rows[i];
  }
  return null;
}

function storeOrderPayload(orderId, telegramId, products, meta) {
  const payload = {
    created_at: Date.now(),
    telegram_id: String(telegramId),
    product_total: Number(meta.productTotal || 0),
    payable_goods_total: Number(meta.payableGoodsTotal || 0),
    payable_total: Number(meta.payableTotal || 0),
    managed_product_total: Number(meta.managedTotal || 0),
    total: Number(meta.total || 0),
    needs_delivery: Boolean(meta.needsDelivery),
    managed_order: Boolean(meta.managedOrder),
    repeat_order: Boolean(meta.repeatOrder),
    service_order: Boolean(meta.serviceOrder),
    mixed_order: Boolean(meta.mixedOrder),
    delivery: meta.delivery || {},
    products: products.map(function(product) {
      return {
        id: String(product.id ?? '').trim(),
        name: String(product.name || '').trim() || String(product.title || '').trim() || 'Без названия',
        category: String(product.category || '').trim().toLowerCase(),
        quantity: normalizeQuantity(product.quantity),
        price: normalizeMoney(product.price)
      };
    })
  };

  PropertiesService.getScriptProperties().setProperty(
    ORDER_PAYLOAD_PREFIX + orderId,
    JSON.stringify(payload)
  );
}

function loadOrderPayload(orderId) {
  const key = ORDER_PAYLOAD_PREFIX + orderId;
  const raw = PropertiesService.getScriptProperties().getProperty(key);
  if (!raw) return null;

  try {
    const payload = JSON.parse(raw);
    if (!payload || !Array.isArray(payload.products)) return null;

    if (Date.now() - Number(payload.created_at || 0) > ORDER_PAYLOAD_TTL_MS) {
      PropertiesService.getScriptProperties().deleteProperty(key);
      return null;
    }

    return payload;
  } catch (error) {
    PropertiesService.getScriptProperties().deleteProperty(key);
    return null;
  }
}

function cleanupExpiredOrderPayloads() {
  const properties = PropertiesService.getScriptProperties().getProperties();
  const now = Date.now();

  Object.keys(properties).forEach(function(key) {
    if (key.indexOf(ORDER_PAYLOAD_PREFIX) !== 0) return;

    try {
      const payload = JSON.parse(properties[key]);
      const createdAt = Number(payload && payload.created_at || 0);
      if (!createdAt || now - createdAt > ORDER_PAYLOAD_TTL_MS) {
        PropertiesService.getScriptProperties().deleteProperty(key);
      }
    } catch (error) {
      PropertiesService.getScriptProperties().deleteProperty(key);
    }
  });
}

function telegramApi(botToken, method, payload) {
  const url = 'https://api.telegram.org/bot' + botToken + '/' + method;
  const response = UrlFetchApp.fetch(url, {
    method: 'post',
    contentType: 'application/json',
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  });

  const code = response.getResponseCode();
  const body = response.getContentText();
  if (code < 200 || code >= 300) throw new Error('Telegram API HTTP ' + code + ': ' + body);

  let json;
  try { json = JSON.parse(body); }
  catch (error) { throw new Error('Telegram API вернул некорректный JSON.'); }

  if (!json.ok) throw new Error('Telegram API: ' + String(json.description || 'неизвестная ошибка'));
  return json.result;
}

function validateTelegramInitData(initData) {
  const botToken = getBotToken();
  const params = {};

  String(initData).split('&').forEach(function(part) {
    if (!part) return;
    const index = part.indexOf('=');
    if (index < 0) return;
    const key = decodeURIComponent(part.slice(0, index));
    const value = decodeURIComponent(part.slice(index + 1).replace(/\+/g, ' '));
    params[key] = value;
  });

  const receivedHash = String(params.hash || '');
  if (!receivedHash) throw new Error('В Telegram initData отсутствует hash.');

  const keys = Object.keys(params).filter(key => key !== 'hash').sort();
  const dataCheckString = keys.map(key => key + '=' + params[key]).join('\n');

  const secretKey = Utilities.computeHmacSha256Signature(botToken, 'WebAppData');
  const calculatedHash = bytesToHex(
    Utilities.computeHmacSha256Signature(
      Utilities.newBlob(dataCheckString).getBytes(),
      secretKey
    )
  );

  if (!constantTimeEqual(calculatedHash, receivedHash)) {
    throw new Error('Telegram initData не прошло проверку.');
  }

  const authDate = Number(params.auth_date);
  if (!Number.isFinite(authDate)) throw new Error('В Telegram initData отсутствует auth_date.');

  const age = Math.floor(Date.now() / 1000) - authDate;
  if (age > 24 * 60 * 60) throw new Error('Telegram initData устарело.');
  if (!params.user) throw new Error('В Telegram initData отсутствуют данные пользователя.');

  try {
    return JSON.parse(params.user);
  } catch (error) {
    throw new Error('Не удалось разобрать данные Telegram пользователя.');
  }
}

function nextOrderId(sheet) {
  const now = new Date();
  const timezone = Session.getScriptTimeZone();
  const prefix = Utilities.formatDate(now, timezone, 'yyMM');
  let maxSequence = 0;

  if (sheet.getLastRow() >= 2) {
    const values = sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).getDisplayValues();
    values.forEach(function(row) {
      const id = String(row[0] || '').trim();
      if (!id.startsWith(prefix)) return;
      const suffix = id.slice(prefix.length);
      if (/^\d+$/.test(suffix)) maxSequence = Math.max(maxSequence, Number(suffix));
    });
  }

  return prefix + String(maxSequence + 1).padStart(2, '0');
}

function calculateTotal(products) {
  return products.reduce((sum, product) => sum + normalizeMoney(product.price) * normalizeQuantity(product.quantity), 0);
}

function calculateCategoryTotal(products, targetCategory) {
  return products.reduce((sum, product) => {
    if (String(product.category || '').trim().toLowerCase() !== targetCategory) return sum;
    return sum + normalizeMoney(product.price) * normalizeQuantity(product.quantity);
  }, 0);
}

function calculateManagedTotal(products) {
  return products.reduce((sum, product) => {
    const category = String(product.category || '').trim().toLowerCase();
    if (MANAGED_CATEGORIES.indexOf(category) === -1) return sum;
    return sum + normalizeMoney(product.price) * normalizeQuantity(product.quantity);
  }, 0);
}

function countCategory(products, targetCategory) {
  return products.filter(product => String(product.category || '').trim().toLowerCase() === targetCategory).length;
}

function countManagedProducts(products) {
  return products.filter(product => MANAGED_CATEGORIES.indexOf(String(product.category || '').trim().toLowerCase()) !== -1).length;
}

function buildItemsText(itemsText, products) {
  const raw = String(itemsText || '').trim();
  return raw || buildItemsTextFromProducts(products);
}

function buildItemsTextFromProducts(products) {
  return products.map(function(product) {
    const name = String(product.name || product.title || 'Без названия').trim();
    const category = String(product.category || '').trim().toLowerCase();
    const quantity = normalizeQuantity(product.quantity);
    return category === 'items' ? name + ' (x' + quantity + ')' : name;
  }).join('\n');
}

function normalizeQuantity(value) {
  const n = Number(value);
  if (!Number.isInteger(n) || n < 1) throw new Error('Некорректное количество товара.');
  return n;
}

function normalizeMoney(value) {
  const n = Number(value);
  if (!Number.isFinite(n) || n < 0) throw new Error('Некорректная цена товара.');
  return n;
}

function formatMoney(value) {
  return Number(value || 0).toLocaleString('ru-RU');
}

function formatTelegramUsername(username) {
  const value = String(username || '').trim();
  return value ? (value.charAt(0) === '@' ? value : '@' + value) : '';
}

function getBotToken() {
  const token = PropertiesService.getScriptProperties().getProperty(BOT_TOKEN_PROPERTY);
  if (!token) throw new Error('В Script Properties не задан BOT_TOKEN.');
  return token;
}

function getRequiredSheet(ss, name, headers) {
  let sheet = ss.getSheetByName(name);
  if (!sheet) {
    sheet = ss.insertSheet(name);
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
  } else {
    if (sheet.getLastColumn() < headers.length) {
      sheet.insertColumnsAfter(sheet.getLastColumn(), headers.length - sheet.getLastColumn());
    }
    for (let i = 0; i < headers.length; i++) {
      const cell = sheet.getRange(1, i + 1);
      if (!String(cell.getValue() || '').trim()) cell.setValue(headers[i]);
    }
  }
  return sheet;
}

function bytesToHex(bytes) {
  return bytes.map(function(byte) {
    const value = byte < 0 ? byte + 256 : byte;
    return ('0' + value.toString(16)).slice(-2);
  }).join('');
}

function constantTimeEqual(a, b) {
  a = String(a || '').toLowerCase();
  b = String(b || '').toLowerCase();
  if (a.length !== b.length) return false;

  let result = 0;
  for (let i = 0; i < a.length; i++) {
    result |= a.charCodeAt(i) ^ b.charCodeAt(i);
  }
  return result === 0;
}

function jsonResponse(data) {
  return ContentService
    .createTextOutput(JSON.stringify(data, null, 2))
    .setMimeType(ContentService.MimeType.JSON);
}
