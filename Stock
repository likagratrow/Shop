const SHEET_NAME = 'Прайс';


function doGet() {
  const sheet = SpreadsheetApp
    .getActiveSpreadsheet()
    .getSheetByName(SHEET_NAME);

  if (!sheet) {
    return ContentService
      .createTextOutput('ERROR: sheet "Прайс" not found');
  }

  return ContentService
    .createTextOutput('OK — Apps Script работает. Лист "Прайс" найден.');
}


function doPost(e) {
  try {
    const data = JSON.parse(e.postData.contents);

    if (data.action === 'check_and_decrement') {
      return checkAndDecrement(data.items);
    }

    return jsonResponse({
      ok: false,
      error: 'Unknown action'
    });

  } catch (error) {
    return jsonResponse({
      ok: false,
      error: error.toString()
    });
  }
}


function checkAndDecrement(items) {
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);

  try {
    if (!Array.isArray(items) || !items.length) {
      return jsonResponse({ ok: false, error: 'No items provided' });
    }

    const sheet = SpreadsheetApp
      .getActiveSpreadsheet()
      .getSheetByName(SHEET_NAME);

    if (!sheet) {
      return jsonResponse({
        ok: false,
        error: 'Sheet not found'
      });
    }

    const data = sheet.getDataRange().getValues();
    const requests = {};

    for (const item of items) {
      const name = String(item && item.name || '').trim();
      const requested = Number(item && item.quantity);

      if (!name) {
        return jsonResponse({
          ok: false,
          error: 'Product name is required'
        });
      }

      if (!Number.isInteger(requested) || requested < 1) {
        return jsonResponse({
          ok: false,
          error: 'Invalid quantity'
        });
      }

      const key = normalizeProductName(name);
      requests[key] = (requests[key] || 0) + requested;
    }

    const matched = {};

    for (const key of Object.keys(requests)) {
      const matches = [];

      for (let row = 1; row < data.length; row++) {
        const name = normalizeProductName(data[row][1]);
        if (name === key) matches.push(row);
      }

      if (matches.length === 0) {
        return jsonResponse({
          ok: false,
          error: 'Product not found: ' + key
        });
      }

      if (matches.length > 1) {
        return jsonResponse({
          ok: false,
          error: 'Product name is ambiguous: ' + key
        });
      }

      const row = matches[0];
      const balanceValue = String(data[row][3] ?? '').trim();

      if (
        balanceValue === '∞' ||
        balanceValue === '♾' ||
        balanceValue.toLowerCase() === 'infinity' ||
        balanceValue.toLowerCase() === 'inf'
      ) {
        matched[key] = {row, unlimited: true, balance: Infinity};
        continue;
      }

      const balance = Number(balanceValue);
      if (!Number.isInteger(balance) || balance < 0) {
        return jsonResponse({
          ok: false,
          error: 'Invalid balance for product ' + key
        });
      }

      if (balance < requests[key]) {
        return jsonResponse({
          ok: false,
          error: 'Not enough stock',
          product_name: String(data[row][1] || ''),
          available: balance
        });
      }

      matched[key] = {row, unlimited: false, balance};
    }

    for (const key of Object.keys(requests)) {
      const item = matched[key];
      if (!item || item.unlimited) continue;
      sheet.getRange(item.row + 1, 4).setValue(item.balance - requests[key]);
    }

    return jsonResponse({ ok: true });

  } finally {
    lock.releaseLock();
  }
}

function normalizeProductName(value) {
  return String(value ?? '')
    .normalize('NFKC')
    .trim()
    .replace(/\s+/g, ' ')
    .toLowerCase();
}


function jsonResponse(data) {
  return ContentService
    .createTextOutput(JSON.stringify(data))
    .setMimeType(ContentService.MimeType.JSON);
}
